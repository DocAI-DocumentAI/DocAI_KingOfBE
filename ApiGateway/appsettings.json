{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/auth/{**catch-all}" }
        ]
      },
      "document-route": {
        "ClusterId": "document-cluster",
        "Match": {
          "Path": "/api/document/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/document/{**catch-all}" }
        ]
      },
      "ai-route": {
        "ClusterId": "ai-cluster",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/ai/{**catch-all}" }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notification/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/notification/{**catch-all}" }
        ]
      },
      "chatbox-route": {
        "ClusterId": "chatbox-cluster",
        "Match": {
          "Path": "/api/chatbox/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/chatbox/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth1": {
            "Address": "https://auth.docai.asia"
          }
        }
      },
      "document-cluster": {
        "Destinations": {
          "document1": {
            "Address": "https://doc.docai.asia"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "ai-cluster": {
        "Destinations": {
          "ai1": {
            "Address": "https://ai.docai.asia"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification1": {
            "Address": "https://noti.docai.asia"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      },
      "chatbox-cluster": {
        "Destinations": {
          "chatbox1": {
            "Address": "https://chatbox.docai.asia"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Yarp": "Debug"
    }
  },
  "AllowedHosts": "*"
}

