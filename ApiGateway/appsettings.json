{
  "ReverseProxy": {
    "Routes": {
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Order": 1
      },
      "document_route": {
        "ClusterId": "doc_cluster",
        "Match": { "Path": "/api/document/{**catch-all}" },
        "Order": 2
      },
      "ai_route": {
        "ClusterId": "ai_cluster",
        "Match": { "Path": "/api/ai/{**catch-all}" },
        "Order": 3
      },
      "notify_route": {
        "ClusterId": "notify_cluster",
        "Match": { "Path": "/api/notify/{**catch-all}" },
        "Order": 4
      },
      "chatbox_route": {
        "ClusterId": "chatbox_cluster",
        "Match": { "Path": "/api/chatbox/{**catch-all}" },
        "Order": 5
      }
    },
    "Clusters": {
      "auth_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices", 
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10", 
            "Timeout": "00:00:05", 
            "Path": "/health"       
          }
        },
        "Destinations": {
          "auth1": { "Address": "https://localhost:5001/" },
          "auth2": { "Address": "https://localhost:5101/" }
        }
      },
      "doc_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "doc1": { "Address": "https://localhost:5002/" },
          "doc2": { "Address": "https://localhost:5102/" }
        }
      },
      "ai_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "ai1": { "Address": "https://localhost:5003/" },
          "ai2": { "Address": "https://localhost:5103/" }
        }
      },
      "notify_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "notify1": { "Address": "https://localhost:5004/" },
          "notify2": { "Address": "https://localhost:5104/" }
        }
      },
      "chatbox_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "chatbox1": { "Address": "https://localhost:5005/" },
          "chatbox2": { "Address": "https://localhost:5105/" }
        }
      }
    }
  }
}

