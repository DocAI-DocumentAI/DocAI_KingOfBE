{
  "ReverseProxy": {
    "Routes": {
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Order": 1
      },
      "document_route": {
        "ClusterId": "doc_cluster",
        "Match": { "Path": "/api/document/{**catch-all}" },
        "Order": 2
      },
      "ai_route": {
        "ClusterId": "ai_cluster",
        "Match": { "Path": "/api/ai/{**catch-all}" },
        "Order": 3
      },
      "notify_route": {
        "ClusterId": "notify_cluster",
        "Match": { "Path": "/api/notify/{**catch-all}" },
        "Order": 4
      }
    },
    "Clusters": {
      "auth_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices", 
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10", 
            "Timeout": "00:00:05", 
            "Path": "/health"       
          }
        },
        "Destinations": {
          "auth1": { "Address": "http://auth.api:5001/" }
        }
      },
      "doc_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "doc1": { "Address": "http://document.api:5002/" }
        }
      },
      "ai_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "ai1": { "Address": "http://ai.api:5003/" }
        }
      },
      "notify_cluster": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "notify1": { "Address": "http://notification.api:5004/" }
        }
      }
    }
  }
}
