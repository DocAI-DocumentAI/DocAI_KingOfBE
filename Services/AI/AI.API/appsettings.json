{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore.Mvc": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Hosting": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "./logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=DocsAI;Username=admin;Password=admin"
    },
    "AllowedHosts": "*",

  "Ollama": {
    "Host": "http://127.0.0.1:11434", // <--- Quan trọng: Trỏ đến địa chỉ Ollama chạy trên máy local
    "ModelName": "deepseek-r1:1.5b", // <--- Tên mô hình chính xác bạn đã pull
    "EmbeddingModelName": "nomic-embed-text:v1.5",
    "TextModel": {
      "ModelId": "phi3:medium-128k"
    },
    "EmbeddingModel": {
      "ModelId": "nomic-embed-text"
    },
    "Temperature": 0.7,
    "TopP": 0.9,
    "NumPredict": 1024
  }
}
