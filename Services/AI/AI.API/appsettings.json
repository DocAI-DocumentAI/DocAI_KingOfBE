{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore.Mvc": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Hosting": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "./logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=DocsAI;Username=admin;Password=admin"
    },
    "AllowedHosts": "*",

    "HuggingFace": {
        "TextModel": "HuggingFaceTB/SmolLM3-3B",
        "TextEndpoint": "https://router.huggingface.co/v1/chat/completions",
        "EmbeddingModel": "sentence-transformers/all-MiniLM-L6-v2",
        "EmbeddingEndpoint": "https://router.huggingface.co/models",
        "ApiKey": "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"
    },
    "AI": {
        "DefaultMaxTokens": 2048,
        "DefaultTemperature": 0.7,
        "DefaultTopP": 0.9
