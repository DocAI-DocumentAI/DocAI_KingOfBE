{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore.Mvc": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Hosting": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "./logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Database=AI_DB;Username=postgres;Password=postgres;Include Error Detail=true"
    },
    "HuggingFace": {
        "TextModel": "microsoft/Phi-3-mini-4k-instruct",
        "TextEndpoint": "https://api-inference.huggingface.co/models/microsoft/Phi-3-mini-4k-instruct",
        "EmbeddingModel": "sentence-transformers/all-MiniLM-L6-v2",
        "EmbeddingEndpoint": "https://api-inference.huggingface.co/models/sentence-transformers/all-MiniLM-L6-v2",
        "ApiKey": "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"
    },
    "Auth": {
        "Authority": "https://your-auth-server",
        "Audience": "ai-api"
    },
    "Cors": {
        "AllowedOrigins": [ "http://localhost:3000", "https://your-frontend.com" ]
    },
    "RateLimiting": {
        "PermitLimit": 100,
        "Window": "1m",
        "QueueProcessingOrder": "OldestFirst",
        "QueueLimit": 10
    },
    "AI": {
        "DefaultMaxTokens": 2048,
        "DefaultTemperature": 0.7,
        "DefaultTopP": 0.9,
        "MaxAllowedTokens": 4096,
        "MaxDocumentsPerRequest": 10,
        "MaxEmbeddingConcurrency": 5,
        "EnableMetrics": true,
        "EnableRequestLogging": true,
        "EnableAutoCleanup": true,
        "MetricsRetentionDays": 90,
        "CleanupIntervalDays": 1,
        "CleanupBatchSize": 1000,
        "MaxMetricsDays": 90,
        "MaxLogContentLength": 5000,
        "CostPerToken": 0.0001,
        "CostCurrency": "USD"
    }
}
