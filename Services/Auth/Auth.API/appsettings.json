{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=__VPS_IP__;Port=5432;Database=__DATABASE_NAME__;Username=postgres;Password=__DATABASE_PASSWORD__",
    "Redis": "redis:6379,abortConnect=false"
  },
  "RabbitMQ": {
    "Host": "rabbitmq",
    "Username": "guest",
    "Password": "guest"
  },
  "Jwt": {
    "Secret": "__JWT_SECRET__",
    "Issuer": "DocAI"
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "Port": "587",
    "Username": "__EMAIL_USERNAME__",
    "Password": "__EMAIL_PASSWORD__",
    "DisplayName": "DocAI System"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": { "path":  "./logs/log-.txt", "rollingInterval": "Day" }
      }
    ]
  },
  "AllowedHosts": "*",
  "GoogleOAuth": {
    "ClientId": "__GG_CLIENT_ID__",
    "ClientSecret": "__GG_CLIENT_SECRET__",
    "RedirectUri": "https://production.docai.asia/api/auth/google/callback"    
  },
  "FrontEnd": {
    "GoogleCallbackUrl": "https://docai.asia/auth/google/callback",
    "LoginUrl": "https://docai.asia/login",
    "ErrorUrl": "https://docai.asia/error"
  }
}
