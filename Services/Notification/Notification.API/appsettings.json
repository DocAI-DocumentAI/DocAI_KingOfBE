{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore.Mvc": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.AspNetCore.Hosting": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "File",
                "Args": {
                    "path": "./logs/log-.txt",
                    "rollingInterval": "Day"
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=__VPS_IP__;Port=5432;Database=NotificationDocsAI;Username=postgres;Password=__DATABASE_PASSWORD__",
        "Redis": "redis:6379,abortConnect=false"
    },
    "Smtp": {
        "SmtpServer": "smtp.gmail.com",
        "Port": "587",
        "Username": "__EMAIL_USERNAME__",
        "Password": "__EMAIL_PASSWORD__",
        "DisplayName": "DocAI System",
        "Host": "smtp.gmail.com",
        "FromAddress": "__EMAIL_USERNAME__",
        "EnableSsl": "true"
    },
    "Email": {
        "SmtpHost": "smtp.gmail.com",
        "SmtpPort": 587,
        "FromEmail": "__EMAIL_USERNAME__",
        "FromPassword": "__DATABASE_PASSWORD__",
        "MaxPerHour": 100,
        "MaxPerDay": 1000
    },
    "Quartz": {
        "ExpiredNotificationCron": "0 0 8 * * ?",
        "NearExpiredNotificationCron": "0 0 9 ? * MON",
        "CleanupCronExpression": "0 0 2 ? * SUN"
    },
    "JWT": {
        "Secret": "__JWT_SECRET__",
        "Issuer": "DocAI"
    },
    "RabbitMQ": {
        "Host": "rabbitmq",
        "Username": "guest",
        "Password": "guest"
    },
    "ApiBaseUrl": "https://docai.asia"

}

